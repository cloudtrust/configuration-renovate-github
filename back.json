{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    ":semanticCommits",
    ":enablePreCommit"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "versioning": "redhat"
    }
  ],
  "postUpdateOptions": ["gomodTidyE"],
  "reviewers": ["basbeu", "vloup"]
}
